# ==============================================================================
# TrustGuard — Forensic Multi-Modal Dossier System
# Environment Configuration Template (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SMTP EMAIL SERVER CONFIGURATION (Password Recovery & Notifications)
# ------------------------------------------------------------------------------
# Password reset recovery emails are delivered via SMTP with single-use,
# cryptographically secure tokens expiring in 15 minutes.
# Tokens and temporary codes are NEVER returned via API responses or logs.
#
# --- OPTION A: GMAIL SETUP (Recommended for live email delivery) ---
# IMPORTANT: Google does NOT allow your regular Gmail password!
# Step 1: Turn ON 2-Step Verification: https://myaccount.google.com/security
# Step 2: Create an App Password: https://myaccount.google.com/apppasswords
#         (Name it "TrustGuard", Google will generate a 16-character app password)
# Step 3: Paste the 16-character code into SMTP_PASSWORD below.
#
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=yourname@gmail.com
# SMTP_PASSWORD=abcdefghijklmnop
# SMTP_FROM_EMAIL=yourname@gmail.com
# SMTP_FROM_NAME=TrustGuard Security
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false
#
# --- OPTION B: OUTLOOK / OFFICE 365 ---
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USERNAME=yourname@outlook.com
# SMTP_PASSWORD=your_password
# SMTP_FROM_EMAIL=yourname@outlook.com
# SMTP_FROM_NAME=TrustGuard Security
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false
#
# --- OPTION C: BREVO / MAILGUN / RESEND / SENDGRID ---
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USERNAME=your_smtp_login
# SMTP_PASSWORD=your_smtp_key
# SMTP_FROM_EMAIL=noreply@yourdomain.com
# SMTP_FROM_NAME=TrustGuard Security
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=TrustGuard Security
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# ------------------------------------------------------------------------------
# 2. CLIENT & FRONTEND INTEGRATION
# ------------------------------------------------------------------------------
FRONTEND_BASE_URL=http://localhost:5173
VITE_API_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 3. SERVER & RUNTIME SETTINGS
# ------------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
FRONTEND_PORT=5173
DEBUG=false
