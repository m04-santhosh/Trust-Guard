# ==============================================================================
# TrustGuard — Forensic Multi-Modal Dossier System
# Environment Configuration Template (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SMTP EMAIL SERVER CONFIGURATION (Password Recovery & Notifications)
# ------------------------------------------------------------------------------
# NOTE: If you do NOT configure SMTP, TrustGuard automatically falls back to 
# Dev Mode: it generates instant 6-digit recovery codes on-screen and in console.
#
# --- OPTION A: GMAIL SETUP (Recommended for live email delivery) ---
# IMPORTANT: Google does NOT allow your regular Gmail password!
# Step 1: Turn ON 2-Step Verification: https://myaccount.google.com/security
# Step 2: Create an App Password: https://myaccount.google.com/apppasswords
#         (Name it "TrustGuard", Google will give you a 16-character code like "abcd efgh ijkl mnop")
# Step 3: Paste the 16-character code into SMTP_PASSWORD below.
#
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=yourname@gmail.com
# SMTP_PASSWORD=abcdefghijklmnop
# SMTP_FROM_EMAIL=yourname@gmail.com
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false
#
# --- OPTION B: OUTLOOK / OFFICE 365 ---
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USERNAME=yourname@outlook.com
# SMTP_PASSWORD=your_password
# SMTP_FROM_EMAIL=yourname@outlook.com
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false
#
# --- OPTION C: BREVO / MAILGUN / RESEND / SENDGRID ---
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USERNAME=your_smtp_login
# SMTP_PASSWORD=your_smtp_key
# SMTP_FROM_EMAIL=noreply@yourdomain.com
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# ------------------------------------------------------------------------------
# 2. SERVER & RUNTIME SETTINGS
# ------------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
FRONTEND_PORT=5173
DEBUG=false
